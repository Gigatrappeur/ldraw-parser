{
  "name": "ldraw-parser",
  "version": "1.0.0-beta",
  "description": "Un parser LDraw minimal pour Node.js (Bun) qui analyse des fichiers .ldr/.mpd et fournit une géométrie plate (FlatGeometry).",
  "main": "src/index.ts",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Gigatrappeur/ldraw-parser"
  },
  "keywords": ["ldraw", "parser", "geometry", "bricks"],
  "author": "Gigatrappeur",
  "scripts": {
    "build": "bun build ./src/index.ts ./src/cli.ts --outdir=dist --target=bun --splitting --minify-syntax --minify-whitespace",
    "test": "bun test test/",
    "tsc": "tsc"
  },
  "devDependencies": {
    "@types/bun": "^1.3.11"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@types/node": "^25.6.0"
  }
}
